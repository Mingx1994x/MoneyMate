# 本機開發用。複製成 .env 後使用（.env 不進版控）。
# 新增必填變數時，同一個 PR 要一併更新 .env.test.example 與 CI workflow 的 env。

NODE_ENV=development
PORT=3001

# app 執行期連線（Render＋Supabase 上為 transaction 模式連線池，:6543）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
# prisma migrate 用（本機與 DATABASE_URL 相同；Supabase 上為 session 模式，:5432）
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# 資料庫 SSL：本機 Docker 不加密。production 必填；Render 上設 true 並設 DATABASE_CA_CERT
DATABASE_SSL=false

# 前面有幾層反向代理（trust proxy）。本機 0；production 必填
TRUST_PROXY_HOPS=0

# 前端網址，多個用逗號分隔
CORS_ORIGIN=http://localhost:3000

# JWT 簽章金鑰（本機用的假值；production 至少 32 字元、不可含 insecure）
JWT_SECRET=dev-insecure-jwt-secret
