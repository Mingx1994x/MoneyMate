# 本機開發用。複製成 .env 後使用（.env 不進版控）。
# 新增必填變數時，同一個 PR 要一併更新 .env.test.example 與 CI workflow 的 env。

NODE_ENV=development
PORT=3001

# app 執行期連線（Supabase 上為 session 模式連線池）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
# prisma migrate 用（本機與 DATABASE_URL 相同）
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# 前端網址，多個用逗號分隔
CORS_ORIGIN=http://localhost:3000
