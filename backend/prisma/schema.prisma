generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions
// - id: generated by the database (gen_random_uuid), so raw SQL inserts also work
// - updatedAt: database default now(); Prisma updates it on every update.
//   Raw SQL UPDATE must set updated_at = now() itself.
// - onDelete: user → user's data = Cascade (seed:demo / tests can delete a user in one go);
//   between business data = Restrict (PRD §14)

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String?       @map("display_name")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  bills        Bill[]
  goal         Goal?

  @@map("users")
}

enum AccountType {
  cash
  bank
  investment
  credit_card

  @@map("account_type")
}

model Account {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  name                 String
  accountType          AccountType @map("account_type")
  currency             String      @default("TWD")
  openingBalance       Decimal     @map("opening_balance") @db.Decimal(14, 2)
  isActive             Boolean     @default(true) @map("is_active")
  isEstimate           Boolean     @default(false) @map("is_estimate")
  deductedFromEstimate Decimal?    @map("deducted_from_estimate") @db.Decimal(14, 2)
  note                 String?
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionToAccount")
  bills             Bill[]

  @@unique([id, userId]) // target of the composite FKs below: a transaction/bill can only use its own user's accounts
  @@index([userId])
  @@map("accounts")
}

enum CategoryType {
  income
  expense

  @@map("category_type")
}

// user_id = null → system category, shared by everyone (P0 only has system categories)
model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  code      String       @unique
  name      String
  type      CategoryType
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]

  @@map("categories")
}

enum TransactionType {
  income
  expense
  transfer

  @@map("transaction_type")
}

model Transaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid // income/expense account, or the "from" account of a transfer
  transactionType TransactionType @map("transaction_type")
  amount          Decimal         @db.Decimal(14, 2)
  categoryId      String?         @map("category_id") @db.Uuid // null for transfers
  toAccountId     String?         @map("to_account_id") @db.Uuid // only for transfers
  transactionDate DateTime        @map("transaction_date") @db.Date // can be in the future
  note            String?
  billId          String?         @unique @map("bill_id") @db.Uuid // set when created by paying a bill
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation("TransactionAccount", fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  toAccount Account?  @relation("TransactionToAccount", fields: [toAccountId, userId], references: [id, userId], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bill      Bill?     @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@index([accountId])
  @@index([toAccountId])
  @@map("transactions")
}

enum LoanStatus {
  active
  closed

  @@map("loan_status")
}

// Loans and bills are separate: no loan_id in P0
model Loan {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  name               String
  loanType           String     @map("loan_type")
  outstandingBalance Decimal    @map("outstanding_balance") @db.Decimal(14, 2) // updated by hand
  monthlyPayment     Decimal    @map("monthly_payment") @db.Decimal(14, 2)
  paymentDay         Int        @map("payment_day") // 1–31
  endDate            DateTime   @map("end_date") @db.Date
  interestRate       Decimal?   @map("interest_rate") @db.Decimal(6, 3) // 0–100, optional; used for the suggested monthly payment
  status             LoanStatus @default(active)
  balanceUpdatedAt   DateTime   @default(now()) @map("balance_updated_at") @db.Timestamptz
  note               String?
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loans")
}

enum Recurrence {
  none
  monthly
  yearly

  @@map("recurrence")
}

enum BillStatus {
  pending
  paid

  @@map("bill_status")
}

model Bill {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  name       String
  amount     Decimal    @db.Decimal(14, 2) // planned amount; the next bill copies it
  categoryId String     @map("category_id") @db.Uuid // expense categories only
  accountId  String     @map("account_id") @db.Uuid // default payment account
  dueDate    DateTime   @map("due_date") @db.Date
  dueDay     Int        @map("due_day") // original day (e.g. 31), for short months
  dueMonth   Int?       @map("due_month") // original month for yearly bills (e.g. 2), for leap years
  seriesId   String     @default(dbgenerated("gen_random_uuid()")) @map("series_id") @db.Uuid // shared by every bill in one repeating series; the next bill copies it
  recurrence Recurrence @default(none)
  status     BillStatus @default(pending)
  paidAmount Decimal?   @map("paid_amount") @db.Decimal(14, 2) // actual amount paid
  paidDate   DateTime?  @map("paid_date") @db.Date
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account     Account      @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  transaction Transaction?

  @@index([userId, dueDate])
  @@index([seriesId, dueDate])
  @@map("bills")
}

// One goal per user. A row exists = onboarding is done.
model Goal {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  name             String    @default("財富自由")
  monthlySpending  Decimal   @map("monthly_spending") @db.Decimal(14, 2) // 1,000–333,000
  targetAmount     Decimal   @map("target_amount") @db.Decimal(14, 2) // = monthly_spending × 300, written only by the goals service
  targetDate       DateTime? @map("target_date") @db.Date // P1
  birthYear        Int?      @map("birth_year") // for FIRE age; asked once on the goal page
  estMonthlySaving Decimal?  @map("est_monthly_saving") @db.Decimal(14, 2) // used only with < 3 full months of records
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// ─────────────────────────────────────────────────────────────
// TODO: add by hand to the FIRST migration's SQL (Prisma can't write these)
//
// users
//   CHECK: email = lower(email)                    -- PRD: email always lowercase
// accounts
//   CHECK: account_type = 'credit_card' OR is_estimate OR opening_balance >= 0
//          (estimate account excluded: §15.9 deduction can make its opening_balance negative;
//           its current balance stays >= 0 by the min() rule — confirm with C)
//   UNIQUE (user_id) WHERE is_estimate = true      -- max 1 estimate account per user
// transactions
//   CHECK: amount > 0
//   CHECK: transfer → to_account_id NOT NULL, category_id NULL, account_id <> to_account_id
//          income/expense → category_id NOT NULL, to_account_id NULL
// loans
//   CHECK: outstanding_balance >= 0 AND monthly_payment > 0 AND payment_day BETWEEN 1 AND 31
//          AND (interest_rate IS NULL OR interest_rate BETWEEN 0 AND 100)
// bills
//   CHECK: status = 'paid' → paid_amount, paid_date NOT NULL; 'pending' → both NULL
//   CHECK: amount > 0 AND (paid_amount IS NULL OR paid_amount > 0)
//          AND due_day BETWEEN 1 AND 31 AND (due_month IS NULL OR due_month BETWEEN 1 AND 12)
//          AND (recurrence <> 'yearly' OR due_month IS NOT NULL)
//          (not "both ways": stop-recurrence turns yearly into none and keeps due_month)
//   UNIQUE (series_id) WHERE status = 'pending'    -- max 1 pending bill per series
// goals
//   CHECK: monthly_spending BETWEEN 1000 AND 333000 AND monthly_spending = trunc(monthly_spending)
//          (PRD §13: monthlySpending is an integer)
//
// NOT as CHECK — rules about "today" (paid_date <= today, end_date < today → closed,
// birth_year <= this year): DB current_date is UTC but our "today" is Asia/Taipei → services.
//
// ⚠️ After creating the first migration: run `prisma migrate dev` again and
//    `prisma migrate diff --from-migrations ... --to-schema ...`. Both must show no changes.
//    Prisma tracks indexes, so it may try to DROP the hand-written partial unique indexes.
//
// ⚠️ Partial unique indexes can't be DEFERRABLE, so bill writes must keep this order (PRD §16):
//    pay:   UPDATE this bill to 'paid'  →  then INSERT the next 'pending' bill
//    unpay: DELETE the next 'pending' bill  →  then set this bill back to 'pending'
//
// Optional (D decides): accounts CHECK currency = 'TWD'
//
// P1: user categories → categories.code can't stay globally unique; change to (user_id, code)
// ─────────────────────────────────────────────────────────────
