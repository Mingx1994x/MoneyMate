generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String        @id @default(uuid()) @db.Uuid
    email        String        @unique
    passwordHash String        @map("password_hash")
    displayName  String?       @map("display_name")
    createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
    updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
    accounts     Account[]
    categories   Category[]
    transactions Transaction[]
    loans        Loan[]
    bills        Bill[]
    goal         Goal?

    @@map("users")
}

enum AccountType {
    cash
    bank
    investment
    credit_card
}

model Account {
    id                   String      @id @default(uuid()) @db.Uuid
    userId               String      @map("user_id") @db.Uuid
    name                 String
    accountType          AccountType @map("account_type")
    currency             String      @default("TWD")
    openingBalance       Decimal     @map("opening_balance") @db.Decimal(14, 2)
    isActive             Boolean     @default(true) @map("is_active")
    isEstimate           Boolean     @default(false) @map("is_estimate")
    deductedFromEstimate Decimal?    @map("deducted_from_estimate") @db.Decimal(14, 2)
    note                 String?
    createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
    updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz

    user              User          @relation(fields: [userId], references: [id])
    transactions      Transaction[] @relation("TransactionAccount")
    incomingTransfers Transaction[] @relation("TransactionToAccount")
    bills             Bill[]

    @@index([userId])
    @@map("accounts")
}

enum CategoryType {
    income
    expense
}

// user_id = null → system category, shared by everyone (P0 only has system categories)
model Category {
    id        String       @id @default(uuid()) @db.Uuid
    userId    String?      @map("user_id") @db.Uuid
    code      String       @unique
    name      String
    type      CategoryType
    sortOrder Int          @default(0) @map("sort_order")
    isActive  Boolean      @default(true) @map("is_active")

    user         User?         @relation(fields: [userId], references: [id])
    transactions Transaction[]
    bills        Bill[]

    @@map("categories")
}

enum TransactionType {
    income
    expense
    transfer
}

model Transaction {
    id              String          @id @default(uuid()) @db.Uuid
    userId          String          @map("user_id") @db.Uuid
    accountId       String          @map("account_id") @db.Uuid // income/expense account, or the "from" account of a transfer
    transactionType TransactionType @map("transaction_type")
    amount          Decimal         @db.Decimal(14, 2)
    categoryId      String?         @map("category_id") @db.Uuid // null for transfers
    toAccountId     String?         @map("to_account_id") @db.Uuid // only for transfers
    transactionDate DateTime        @map("transaction_date") @db.Date // can be in the future
    note            String?
    billId          String?         @unique @map("bill_id") @db.Uuid // set when created by paying a bill
    createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
    updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

    user      User      @relation(fields: [userId], references: [id])
    account   Account   @relation("TransactionAccount", fields: [accountId], references: [id])
    toAccount Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id])
    category  Category? @relation(fields: [categoryId], references: [id])
    bill      Bill?     @relation(fields: [billId], references: [id], onDelete: Restrict)

    @@index([userId, transactionDate])
    @@index([accountId])
    @@index([toAccountId])
    @@map("transactions")
}

enum LoanStatus {
    active
    closed
}

// Loans and bills are separate: no loan_id in P0
model Loan {
    id                 String     @id @default(uuid()) @db.Uuid
    userId             String     @map("user_id") @db.Uuid
    name               String
    loanType           String     @map("loan_type")
    outstandingBalance Decimal    @map("outstanding_balance") @db.Decimal(14, 2) // updated by hand
    monthlyPayment     Decimal    @map("monthly_payment") @db.Decimal(14, 2)
    paymentDay         Int        @map("payment_day") // 1–31
    endDate            DateTime   @map("end_date") @db.Date
    interestRate       Decimal?   @map("interest_rate") @db.Decimal(6, 3) // 0–100, optional; used for the suggested monthly payment
    status             LoanStatus @default(active)
    balanceUpdatedAt   DateTime   @default(now()) @map("balance_updated_at") @db.Timestamptz
    note               String?
    createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
    updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

    user User @relation(fields: [userId], references: [id])

    @@index([userId])
    @@map("loans")
}

enum Recurrence {
    none
    monthly
    yearly
}

enum BillStatus {
    pending
    paid
}

model Bill {
    id         String     @id @default(uuid()) @db.Uuid
    userId     String     @map("user_id") @db.Uuid
    name       String
    amount     Decimal    @db.Decimal(14, 2) // planned amount; the next bill copies it
    categoryId String     @map("category_id") @db.Uuid // expense categories only
    accountId  String     @map("account_id") @db.Uuid // default payment account
    dueDate    DateTime   @map("due_date") @db.Date
    dueDay     Int        @map("due_day") // original day (e.g. 31), for short months
    dueMonth   Int?       @map("due_month") // original month for yearly bills (e.g. 2), for leap years
    seriesId   String     @map("series_id") @db.Uuid // shared by every bill in one repeating series
    recurrence Recurrence @default(none)
    status     BillStatus @default(pending)
    paidAmount Decimal?   @map("paid_amount") @db.Decimal(14, 2) // actual amount paid
    paidDate   DateTime?  @map("paid_date") @db.Date
    note       String?
    createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
    updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

    user        User         @relation(fields: [userId], references: [id])
    category    Category     @relation(fields: [categoryId], references: [id])
    account     Account      @relation(fields: [accountId], references: [id])
    transaction Transaction?

    @@index([userId, dueDate])
    @@index([seriesId, dueDate])
    @@map("bills")
}

// One goal per user. A row exists = onboarding is done.
model Goal {
    id               String    @id @default(uuid()) @db.Uuid
    userId           String    @unique @map("user_id") @db.Uuid
    name             String    @default("財富自由")
    monthlySpending  Decimal   @map("monthly_spending") @db.Decimal(14, 2) // 1,000–333,000
    targetAmount     Decimal   @map("target_amount") @db.Decimal(14, 2) // = monthly_spending × 300, written only by the goals service
    targetDate       DateTime? @map("target_date") @db.Date // P1
    birthYear        Int?      @map("birth_year") // for FIRE age; asked once on the goal page
    estMonthlySaving Decimal?  @map("est_monthly_saving") @db.Decimal(14, 2) // used only with < 3 full months of records
    createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

    user User @relation(fields: [userId], references: [id])

    @@map("goals")
}

