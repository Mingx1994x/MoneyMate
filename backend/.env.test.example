# 測試用。複製成 .env.test 後使用（.env.test 不進版控）；CI 在 e2e 前會複製這份。
# 資料庫一定要是 *_test，scripts/assert-test-db.mjs 與 createTestApp 會檢查。
# 機密的假值一律短於 32 字元並含 insecure，避免被誤用在正式環境。

NODE_ENV=test
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app_test

CORS_ORIGIN=http://localhost:3000
