          },
          "interestRate": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100,
            "description": "年利率 %，例如 3 代表 3%；最多 3 位小數。不知道可以不填",
            "example": 3
          },
          "status": {
            "default": "active",
            "example": "active",
            "allOf": [
