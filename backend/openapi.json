{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "資料庫連不到或逾時",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                },
                "example": {
                  "status": "error",
                  "db": "down"
                }
              }
            }
          }
        },
        "summary": "確認服務與資料庫正常",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/loans/payment-preview": {
      "get": {
        "description": "本息平均攤還（PRD 15.8）：每期月付四捨五入到元，最後一期吸收尾差。只計算，不讀寫資料庫。\n\n期數從台北本月算到結清日所在月份（含頭尾），至少 1，所以同一組參數的結果會隨月份改變。\n\n前端呼叫條件：餘額 > 0、利率有填、結清日合法而且不早於台北今天才呼叫；其他情況不呼叫，也不顯示總利息。建議 debounce 300ms，並取消前一次請求。",
        "operationId": "Loans_paymentPreview",
        "parameters": [
          {
            "name": "outstandingBalance",
            "required": true,
            "in": "query",
            "description": "未償餘額，金額字串，> 0",
            "schema": {
              "example": "1000000.00",
              "type": "string"
            }
          },
          {
            "name": "interestRate",
            "required": true,
            "in": "query",
            "description": "年利率 %，最多 3 位小數；空字串回 400，不會被當成 0%",
            "schema": {
              "minimum": 0,
              "maximum": 100,
              "example": 3,
              "type": "number"
            }
          },
          {
            "name": "endDate",
            "required": true,
            "in": "query",
            "description": "結清日。早於本月時期數視為 1；晚於台北今天加 50 年回 400 VALIDATION_FAILED",
            "schema": {
              "format": "date",
              "example": "2031-09-30",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanPaymentPreviewResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`：輸入的資料有誤，請檢查標示的欄位\n\n`AMOUNT_INVALID`：金額格式不正確\n\n`AMOUNT_NOT_POSITIVE`：金額必須大於 0",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】試算建議每月還款與預估總利息",
        "tags": [
          "loans"
        ]
      }
    },
    "/api/v1/loans": {
      "get": {
        "description": "包含已結清的貸款，不分頁。排序：active 在前，同一組內依 createdAt 由新到舊，相同時再依 id。",
        "operationId": "Loans_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】列出貸款",
        "tags": [
          "loans"
        ]
      },
      "post": {
        "description": "沒帶 monthlyPayment 時，後端依年利率自動計算。以下情況回 LOAN_MONTHLY_PAYMENT_REQUIRED：沒帶 monthlyPayment，而且 interestRate 沒帶或為 null；或 outstandingBalance 是 0（算不出大於 0 的月付）。前端表單一律帶 monthlyPayment（用試算結果預填）。\n\n結清日早於台北今天時 status 必須是 closed，否則回 LOAN_END_DATE_IN_PAST；晚於台北今天加 50 年回 VALIDATION_FAILED（field: endDate）。",
        "operationId": "Loans_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLoanDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`：輸入的資料有誤，請檢查標示的欄位\n\n`AMOUNT_INVALID`：金額格式不正確\n\n`AMOUNT_NOT_POSITIVE`：金額必須大於 0\n\n`AMOUNT_NEGATIVE`：金額不可為負數\n\n`NAME_INVALID`：名稱需為 1 到 30 個字\n\n`LOAN_END_DATE_IN_PAST`：結清日已經過了，請修改結清日，或把狀態設為已結清\n\n`LOAN_MONTHLY_PAYMENT_REQUIRED`：沒有填年利率時，請自己填每月還款",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】新增貸款",
        "tags": [
          "loans"
        ]
      }
    },
    "/api/v1/loans/{id}": {
      "get": {
        "description": "不存在、屬於他人或 id 不是 UUID，一律回 404。",
        "operationId": "Loans_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "`LOAN_NOT_FOUND`：找不到這筆貸款",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】取得單筆貸款",
        "tags": [
          "loans"
        ]
      },
      "patch": {
        "description": "沒傳的欄位保持原值；interestRate、note 傳 null 代表清空，其他欄位傳 null 回 400。\n\n不自動重算 monthlyPayment：前端改了餘額、利率或結清日時，自己重新試算並帶上新的月付。\n\n用「原值合併請求」後的結果檢查：status 不是 closed 而且結清日早於台北今天，回 LOAN_END_DATE_IN_PAST（包含把 closed 改回 active 但結清日沒改）；結清日晚於台北今天加 50 年回 VALIDATION_FAILED。\n\n請求有帶 outstandingBalance 就更新 balanceUpdatedAt，即使數字相同。",
        "operationId": "Loans_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLoanDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`：輸入的資料有誤，請檢查標示的欄位\n\n`AMOUNT_INVALID`：金額格式不正確\n\n`AMOUNT_NOT_POSITIVE`：金額必須大於 0\n\n`AMOUNT_NEGATIVE`：金額不可為負數\n\n`NAME_INVALID`：名稱需為 1 到 30 個字\n\n`LOAN_END_DATE_IN_PAST`：結清日已經過了，請修改結清日，或把狀態設為已結清",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "`LOAN_NOT_FOUND`：找不到這筆貸款",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】修改貸款",
        "tags": [
          "loans"
        ]
      },
      "delete": {
        "description": "active 的貸款也可以刪。貸款和帳單、交易沒有關聯，刪除不影響它們。",
        "operationId": "Loans_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "`AUTH_UNAUTHENTICATED`：請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "`LOAN_NOT_FOUND`：找不到這筆貸款",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "501": {
            "description": "`NOT_IMPLEMENTED`：這個功能還在開發中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "【未實作】刪除貸款（不會刪除帳單）",
        "tags": [
          "loans"
        ]
      }
    }
  },
  "info": {
    "title": "Money Mate API",
    "description": "金額為字串（例如 \"1234.00\"）、日期為 YYYY-MM-DD、時間戳為 ISO 8601 UTC。\n\n標示【未實作】的端點目前回 501。\n\n錯誤代碼見 repo 的 docs/error-codes.md。",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "AUTH_UNAUTHENTICATED",
          "BAD_REQUEST",
          "CONFLICT",
          "FORBIDDEN",
          "INTERNAL_ERROR",
          "NOT_FOUND",
          "NOT_IMPLEMENTED",
          "PAYLOAD_TOO_LARGE",
          "TOO_MANY_REQUESTS",
          "UNSUPPORTED_MEDIA_TYPE",
          "VALIDATION_FAILED",
          "AMOUNT_INVALID",
          "AMOUNT_NEGATIVE",
          "AMOUNT_NOT_POSITIVE",
          "NAME_INVALID",
          "AUTH_EMAIL_TAKEN",
          "AUTH_INVALID_CREDENTIALS",
          "ONBOARDING_ALREADY_DONE",
          "ONBOARDING_REQUIRED",
          "ACCOUNT_DEACTIVATE_BLOCKED",
          "ACCOUNT_IN_USE",
          "ACCOUNT_INACTIVE",
          "ACCOUNT_NOT_FOUND",
          "OPENING_BALANCE_NEGATIVE",
          "CATEGORY_NOT_FOUND",
          "CATEGORY_TYPE_MISMATCH",
          "BILL_LINKED_TRANSACTION",
          "TRANSACTION_FIELDS_MISMATCH",
          "TRANSACTION_NOT_FOUND",
          "TRANSFER_SAME_ACCOUNT",
          "BILL_ALREADY_PAID",
          "BILL_NOT_FOUND",
          "NEXT_BILL_ALREADY_PAID",
          "PAID_DATE_IN_FUTURE",
          "LOAN_END_DATE_IN_PAST",
          "LOAN_MONTHLY_PAYMENT_REQUIRED",
          "LOAN_NOT_FOUND"
        ],
        "description": "前端只用這個判斷；遇到不認得的代碼時顯示 message"
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "請求中的屬性路徑，與送出的 camelCase 名稱相同",
            "example": "endDate"
          },
          "code": {
            "example": "LOAN_END_DATE_IN_PAST",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "該代碼在代碼表裡的訊息",
            "example": "結清日已經過了，請修改結清日，或把狀態設為已結清"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "code": {
            "description": "前端只用這個判斷；遇到不認得的代碼時顯示 message",
            "example": "LOAN_NOT_FOUND",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "可直接顯示的繁中句子",
            "example": "找不到這筆貸款"
          },
          "details": {
            "description": "跟欄位有關的錯誤才有內容，否則是空陣列",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "requestId": {
            "type": "string",
            "description": "與回應標頭 X-Request-Id 相同（INF-5 之後）",
            "example": "3f0c9a52-6f1e-4d0a-9a51-2a4c1b7e8d10"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 1,
            "description": "只有 429 才有：幾秒後可以再試",
            "example": 60
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "details",
          "requestId"
        ]
      },
      "LoanPaymentPreviewResponseDto": {
        "type": "object",
        "properties": {
          "monthlyPayment": {
            "type": "string",
            "description": "建議每月還款，到元",
            "example": "17969.00"
          },
          "totalInterest": {
            "type": "string",
            "description": "預估總利息",
            "example": "78120.00"
          },
          "installments": {
            "type": "integer",
            "minimum": 1,
            "description": "剩餘期數：台北本月到結清日所在月份（含頭尾），至少 1",
            "example": 60
          }
        },
        "required": [
          "monthlyPayment",
          "totalInterest",
          "installments"
        ]
      },
      "LoanType": {
        "type": "string",
        "enum": [
          "mortgage",
          "car",
          "personal",
          "student",
          "other"
        ]
      },
      "LoanStatus": {
        "type": "string",
        "enum": [
          "active",
          "closed"
        ]
      },
      "LoanResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f0c9a52-6f1e-4d0a-9a51-2a4c1b7e8d10"
          },
          "name": {
            "type": "string",
            "example": "房貸"
          },
          "loanType": {
            "example": "mortgage",
            "allOf": [
              {
                "$ref": "#/components/schemas/LoanType"
              }
            ]
          },
          "outstandingBalance": {
            "type": "string",
            "description": "未償餘額，金額字串",
            "example": "1000000.00"
          },
          "monthlyPayment": {
            "type": "string",
            "description": "每月還款，金額字串",
            "example": "17969.00"
          },
          "paymentDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "example": 5
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2031-09-30"
          },
          "interestRate": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100,
            "description": "年利率 %，沒填時是 null",
            "example": 3
          },
          "status": {
            "example": "active",
            "allOf": [
              {
                "$ref": "#/components/schemas/LoanStatus"
              }
            ]
          },
          "balanceUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "最後一次更新未償餘額的時間（請求有帶 outstandingBalance 就更新，即使數字相同）",
            "example": "2026-10-24T02:30:00.000Z"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "example": "每月 5 日自動扣款"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-24T02:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-24T02:30:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "loanType",
          "outstandingBalance",
          "monthlyPayment",
          "paymentDay",
          "endDate",
          "interestRate",
          "status",
          "balanceUpdatedAt",
          "note",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoanListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoanResponseDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateLoanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
