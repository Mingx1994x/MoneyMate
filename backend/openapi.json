            ]
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "description": "備註，最多 200 字；空字串存成 null",
            "example": "每月 5 日自動扣款"
          }
        },
        "required": [
          "name",
          "loanType",
          "outstandingBalance",
          "paymentDay",
          "endDate"
        ]
