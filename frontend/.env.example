# 複製成 .env 後依需要修改（.env 不進版控）。沒有 .env 時用 nuxt.config.ts 的預設值。

# API 模式：http＝連 NestJS 後端（預設）；mock＝瀏覽器內的假後端（不用開後端）
NUXT_PUBLIC_API_MODE=http

# 後端網址（本機後端在 3001，Swagger 在 http://localhost:3001/api/docs）
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# ⚠️ 暫時：問卷 API 還沒完成（回 501），打開後登入後不會被導去問卷頁，才能測其他頁面。問卷 API 完成後移除
NUXT_PUBLIC_SKIP_ONBOARDING=true
